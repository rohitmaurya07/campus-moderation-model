# Standalone Moderation Service Configuration

# Port to listen on
PORT=5001

# Environment (development / production)
NODE_ENV=development

# Optional API key for authenticating incoming requests from other apps
# Leave empty to allow unauthenticated access on internal networks
API_KEY=

# Allowed CORS origins (comma-separated or * for any)
CORS_ORIGIN=*

# Enable or disable local image moderation model
ENABLE_IMAGE_MODERATION=true

# Rate limit: Maximum requests per windowMs (e.g. 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Request body size limits (e.g. for base64 images)
MAX_BODY_SIZE=25mb
